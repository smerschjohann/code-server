@@ -599,7 +600,8 @@ suite('TerminalInstance', () => {
-		test('should use pathService.fileURI for remote terminal', async () => {
+		test('should use vscode-remote:// URI for remote terminal', async () => {
 			const testCwd = '/test/remote/path';
 			const instance = createMockTerminalInstance({
 				cwd: testCwd,
@@ -612,6 +614,33 @@ suite('TerminalInstance', () => {
 			strictEqual(result?.path, testCwd);
 		});
 
+		test('should strip URI scheme when cwd is a URI string in remote context', async () => {
+			// Simulate the bug: agent host sends cwd as 'file:///home/coder/dev/project'
+			const instance = createMockTerminalInstance({
