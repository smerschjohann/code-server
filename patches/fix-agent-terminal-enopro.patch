 .../agentHost/node/agentHostTerminalManager.ts     | 10 ++++--
 .../contrib/terminal/browser/agentHostPty.ts       |  4 +--
 .../contrib/terminal/browser/terminalInstance.ts   | 31 +++++++++++++-----
 .../terminal/test/browser/agentHostPty.test.ts     | 17 ++++++++++
 .../terminal/test/browser/terminalInstance.test.ts | 35 ++++++++++++++------
 6 files changed, 79 insertions(+), 22 deletions(-)

diff --git a/src/vs/platform/agentHost/common/state/protocol/commands.ts b/src/vs/platform/agentHost/common/state/protocol/commands.ts
index xxxxxxx..xxxxxxx 100644
--- a/src/vs/platform/agentHost/common/state/protocol/commands.ts
+++ b/src/vs/platform/agentHost/common/state/protocol/commands.ts
@@ -234,7 +234,7 @@ export interface ICreateTerminalParams {
 	/** Human-readable terminal name */
 	name?: string;
-	/** Initial working directory URI */
-	cwd?: URI;
+	/** Initial working directory as a filesystem path (not a URI string) */
+	cwd?: string;
 	/** Initial terminal width in columns */
 	cols?: number;
 	/** Initial terminal height in rows */
diff --git a/src/vs/platform/agentHost/node/agentHostTerminalManager.ts b/src/vs/platform/agentHost/node/agentHostTerminalManager.ts
index xxxxxxx..xxxxxxx 100644
--- a/src/vs/platform/agentHost/node/agentHostTerminalManager.ts
+++ b/src/vs/platform/agentHost/node/agentHostTerminalManager.ts
@@ -6,6 +6,7 @@ import { Disposable, DisposableStore, IDisposable, toDisposable } from '../../../base/common/lifecycle.js';
 import { Emitter } from '../../../base/common/event.js';
 import * as platform from '../../../base/common/platform.js';
+import { URI } from '../../../base/common/uri.js';
 import { ILogService } from '../../log/common/log.js';
 import { createDecorator } from '../../instantiation/common/instantiation.js';
 import { ActionType } from '../common/state/protocol/actions.js';
@@ -145,7 +146,12 @@ export class AgentHostTerminalManager extends Disposable implements IAgentHostTe
 		const nodePty = await getNodePty();
 
-		const cwd = params.cwd ?? process.cwd();
+		// params.cwd is typed as string but may arrive as a URI string (e.g.
+		// "file:///path") when sent over the JSON-RPC protocol from older clients.
+		// Defensively convert to a plain filesystem path so node-pty doesn't fail.
+		const rawCwd = params.cwd;
+		const cwd = rawCwd
+			? (rawCwd.includes('://') ? URI.parse(rawCwd).fsPath : rawCwd)
+			: process.cwd();
 		const cols = params.cols ?? 80;
 		const rows = params.rows ?? 24;
diff --git a/src/vs/workbench/contrib/terminal/browser/agentHostPty.ts b/src/vs/workbench/contrib/terminal/browser/agentHostPty.ts
index xxxxxxx..xxxxxxx 100644
--- a/src/vs/workbench/contrib/terminal/browser/agentHostPty.ts
+++ b/src/vs/workbench/contrib/terminal/browser/agentHostPty.ts
@@ -69,7 +69,7 @@ export class AgentHostPty extends BasePty implements ITerminalChildProcess {
 			if (!this._options?.attachOnly) {
 				await this._connection.createTerminal({
 					terminal: this._terminalUri.toString(),
 					claim: { kind: TerminalClaimKind.Client, clientId: this._connection.clientId },
 					name: this._options?.name,
-					cwd: this._options?.cwd?.toString(),
+					cwd: this._options?.cwd?.fsPath,
 					cols: this._lastDimensions.cols > 0 ? this._lastDimensions.cols : undefined,
 					rows: this._lastDimensions.rows > 0 ? this._lastDimensions.rows : undefined,
 				});
diff --git a/src/vs/workbench/contrib/terminal/browser/terminalInstance.ts b/src/vs/workbench/contrib/terminal/browser/terminalInstance.ts
index xxxxxxx..xxxxxxx 100644
--- a/src/vs/workbench/contrib/terminal/browser/terminalInstance.ts
+++ b/src/vs/workbench/contrib/terminal/browser/terminalInstance.ts
@@ -2306,14 +2306,29 @@ export class TerminalInstance extends Disposable implements ITerminalInstance {
 	async getCwdResource(): Promise<URI | undefined> {
 		const cwd = this.capabilities.get(TerminalCapability.CwdDetection)?.getCwd();
 		if (!cwd) {
 			return undefined;
 		}
 		let resource: URI;
 		if (this.remoteAuthority) {
-			resource = await this._pathService.fileURI(cwd);
+			// In a remote context, create a vscode-remote:// URI so the browser's
+			// RemoteFileSystemProvider can resolve it. pathService.fileURI() always
+			// produces file:// URIs which are inaccessible from the browser renderer
+			// (no DiskFileSystemProvider registered there → ENOPRO).
+			const cwdPath = cwd.includes('://')
+				? URI.parse(cwd).path   // strip scheme+authority from any URI string
+				: cwd;
+			resource = URI.from({ scheme: Schemas.vscodeRemote, authority: this.remoteAuthority, path: cwdPath });
 		} else {
 			resource = URI.file(cwd);
 		}
-		if (await this._fileService.exists(resource)) {
-			return resource;
+		try {
+			if (await this._fileService.exists(resource)) {
+				return resource;
+			}
+		} catch {
+			// File system provider may be unavailable for this scheme (e.g. no
+			// file:// provider in the browser renderer). Return undefined so
+			// callers fall back gracefully instead of surfacing an ENOPRO error.
 		}
 		return undefined;
 	}
