@@ -554,11 +551,15 @@ suite('TerminalInstance', () => {
 				async getCwdResource(): Promise<URI | undefined> {
 					const cwd = this.capabilities.get(TerminalCapability.CwdDetection)?.getCwd();
 					if (!cwd) { return undefined; }
 					let resource: URI;
 					if (this.remoteAuthority) {
-						resource = await mockPathService.fileURI(cwd);
+						const cwdPath = cwd.includes('://')
+							? URI.parse(cwd).path
+							: cwd;
+						resource = URI.from({ scheme: Schemas.vscodeRemote, authority: this.remoteAuthority, path: cwdPath });
 					} else {
 						resource = URI.file(cwd);
 					}
-					if (await mockFileService.exists(resource)) {
-						return resource;
+					try {
+						if (await mockFileService.exists(resource)) { return resource; }
